# Copy to auth.env and fill in. auth.env is gitignored.
# YouTrack base URL — no trailing slash, include /youtrack only if self-hosted under a subpath.
YOUTRACK_BASE_URL=https://freshflow.youtrack.cloud
# Permanent token: YouTrack > Profile > Account Security > New token (scope: YouTrack).
YOUTRACK_TOKEN=perm:xxxx
# Target project short name (e.g. AVE).
YOUTRACK_PROJECT=AVE
# Opt-in label that marks an issue for this pipeline.
YOUTRACK_LABEL=avensio-e2e
# Optional ntfy push (leave blank to disable).
NTFY_URL=
NTFY_TOPIC=
